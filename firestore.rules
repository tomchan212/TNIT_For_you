rules_version = '2';

// Access control for HKCYS TINT Just For You.
//
// Participants sign in with Firebase Email/Password where the address is
// derived from the participant id (1A -> 1a@tnit.local) and the password is
// their phone number. That gives every request a verified identity without
// needing Cloud Functions, so these rules can be enforced by Google rather
// than trusted to the frontend.
//
// Remember that rules are not filters: a query that could return one forbidden
// document fails entirely, so client queries must carry a matching where().

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'admin@tnit.local';
    }

    function isParticipant() {
      return signedIn() && !isAdmin();
    }

    function pid() {
      return request.auth.token.email.split('@')[0].upper();
    }

    // Seat roster ids look like 1A…6H. Everyone else (WILL, PHOEBE, …) is Staff.
    function isSeatId(id) {
      return id.matches('^[0-9][A-H]$');
    }

    function isStaffPerson() {
      return isParticipant() && !isSeatId(pid());
    }

    function participantDoc(id) {
      return get(/databases/$(database)/documents/participants/$(id));
    }

    function myGroupId() {
      return participantDoc(pid()).data.group_id;
    }

    function isNumberedGroup(groupId) {
      return groupId is string && groupId.matches('^GROUP_[0-9]+$');
    }

    // Staff moved into a numbered group may facilitate that group only.
    function isFacilitatorOf(groupId) {
      return isStaffPerson()
        && isNumberedGroup(groupId)
        && myGroupId() == groupId;
    }

    function messagingOpenGlobal() {
      return get(/databases/$(database)/documents/config/messaging).data.status == 'OPEN';
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function groupDoc(groupId) {
      return get(groupPath(groupId));
    }

    // Resource has no .exists() method — use the top-level exists() function.
    // Empty / unknown voting_status values must fall back to the global config,
    // matching the client’s effectiveVotingConfigForGroup().
    function groupMessagingOpen(groupId) {
      return !exists(groupPath(groupId))
        ? true
        : (
          !('messaging_status' in groupDoc(groupId).data)
            ? true
            : groupDoc(groupId).data.messaging_status != 'CLOSE'
        );
    }

    // Admin global CLOSE is a master kill-switch; group CLOSE is an override.
    function messagingOpenFor(groupId) {
      return messagingOpenGlobal() && groupMessagingOpen(groupId);
    }

    function globalVotingStatus() {
      return get(/databases/$(database)/documents/config/voting).data.voting_status;
    }

    function groupVotingOverride(groupId) {
      return !exists(groupPath(groupId))
        ? ''
        : (
          !('voting_status' in groupDoc(groupId).data)
            ? ''
            : (
              !(groupDoc(groupId).data.voting_status in
                ['DRAFT', 'VOTING_OPEN', 'VOTING_CLOSED', 'CALCULATED', 'PUBLISHED'])
                ? ''
                : groupDoc(groupId).data.voting_status
            )
        );
    }

    function votingStatusFor(groupId) {
      return groupVotingOverride(groupId) == ''
        ? globalVotingStatus()
        : groupVotingOverride(groupId);
    }

    function myVotingStatus() {
      return votingStatusFor(myGroupId());
    }

    // Roster: readable by everyone signed in. Admin may edit freely; each
    // participant may only change their own display_name. Staff facilitators
    // may bump force_logout_rev on anyone in their numbered group (seats +
    // other Staff assigned to that group), but not on themselves.
    match /participants/{participantId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isParticipant()
        && participantId == pid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['display_name'])
        && request.resource.data.display_name is string
        && request.resource.data.display_name.size() <= 40
        && request.resource.data.participant_id == resource.data.participant_id
        && request.resource.data.group_id == resource.data.group_id
      ) || (
        isFacilitatorOf(resource.data.group_id)
        && participantId != pid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['force_logout_rev'])
        && request.resource.data.participant_id == resource.data.participant_id
        && request.resource.data.group_id == resource.data.group_id
      );
    }

    // Phone numbers double as login passwords, so they live apart from the
    // roster that every participant can read.
    match /contacts/{participantId} {
      allow read, write: if isAdmin();
    }

    match /trophies/{trophyId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /config/{document} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Per-group display name + messaging/voting overrides. Facilitators may
    // only touch the numbered group they currently belong to.
    match /groups/{groupId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (
        isFacilitatorOf(groupId)
        && request.resource.data.group_id == groupId
        && (!('display_name' in request.resource.data)
          || (request.resource.data.display_name is string
            && request.resource.data.display_name.size() <= 40))
        && (!('messaging_status' in request.resource.data)
          || request.resource.data.messaging_status in ['OPEN', 'CLOSE'])
        && (!('voting_status' in request.resource.data)
          || request.resource.data.voting_status in
            ['DRAFT', 'VOTING_OPEN', 'VOTING_CLOSED', 'CALCULATED', 'PUBLISHED'])
      );
      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      // Inbox / sent queries filter on receiver_id or sender_id. Staff
      // facilitators query thread_group_id == their group for intra-group mail.
      allow read: if isAdmin() || (signedIn() && (
        resource.data.receiver_id == pid()
        || resource.data.sender_id == pid()
        || (
          resource.data.thread_group_id is string
          && resource.data.thread_group_id != ''
          && isFacilitatorOf(resource.data.thread_group_id)
        )
      ));

      allow create: if isParticipant()
        && messagingOpenFor(participantDoc(pid()).data.group_id)
        && request.resource.data.sender_id == pid()
        && request.resource.data.receiver_id is string
        && request.resource.data.receiver_id != pid()
        && request.resource.data.status == 'active'
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        // The real 300 character limit is enforced in the UI. This is a wider
        // abuse guard so that emoji, which the two engines count differently,
        // can never trigger a confusing server-side rejection.
        && request.resource.data.content.size() <= 500
        && request.resource.data.sender_group_id == participantDoc(pid()).data.group_id
        && (
          request.resource.data.thread_group_id == ''
          || (
            request.resource.data.thread_group_id == request.resource.data.sender_group_id
            && request.resource.data.thread_group_id
              == participantDoc(request.resource.data.receiver_id).data.group_id
          )
        );

      // Retracting marks a message deleted so it stays auditable. Removing it
      // outright is the admin's clean-up tool between rehearsal and the event.
      // Facilitators may retract / restore intra-group threads they monitor.
      allow update: if isAdmin() || (
        isFacilitatorOf(resource.data.thread_group_id)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'deleted_at'])
        && request.resource.data.status in ['active', 'deleted']
      );
      allow delete: if isAdmin();
    }

    // One document per participant holds that participant's whole ballot, so
    // two people voting at the same time can never touch each other's rows.
    match /submissions/{participantId} {
      allow read: if isAdmin()
        || (signedIn() && participantId == pid())
        || (
          isFacilitatorOf(participantDoc(participantId).data.group_id)
        );
      allow write: if isAdmin() || (isParticipant()
        && isSeatId(pid())
        && isSeatId(participantId)
        && participantId == pid()
        && myVotingStatus() == 'VOTING_OPEN');
    }

    match /results/{participantId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && participantId == pid()
          && myVotingStatus() == 'PUBLISHED'
        )
        || isFacilitatorOf(participantDoc(participantId).data.group_id);
      allow write: if isAdmin()
        || isFacilitatorOf(participantDoc(participantId).data.group_id);
    }

    // Login presence: each participant may only write their own document.
    // Admin reads the whole collection. Staff facilitators read / delete
    // presence for anyone in the numbered group they facilitate (except
    // their own presence, which they may still delete via the self rule).
    match /presence/{participantId} {
      allow read: if isAdmin()
        || isFacilitatorOf(participantDoc(participantId).data.group_id);
      allow create, update: if isParticipant()
        && participantId == pid()
        && request.resource.data.participant_id == pid();
      allow delete: if isAdmin()
        || (isParticipant() && participantId == pid())
        || (
          isFacilitatorOf(participantDoc(participantId).data.group_id)
          && participantId != pid()
        );
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
